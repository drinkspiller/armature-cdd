{
  "armature-ask-question-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "ask_question",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/ask_question_guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ./hooks/ask_question_guard.py",
        "timeout": 5
      }
    ]
  }
}
